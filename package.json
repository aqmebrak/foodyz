{
  "name": "foodyz",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:setup": "prisma migrate deploy && pnpm db:seed",
    "db:test:setup": "dotenv -e .env.test -o -- prisma migrate deploy && dotenv -e .env.test -o -- pnpm db:seed",
    "db:test:reset": "dotenv -e .env.test -o -- prisma migrate reset --force --skip-seed && pnpm db:test:setup",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.91.0",
    "react-leaflet": "^5.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prisma": "^6.19.3",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
}
