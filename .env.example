# Local dev DB from docker-compose.yml (`pnpm db:up`). Do NOT paste the production connection string here:
# production values belong in Vercel env vars only. e2e uses .env.test (:5434) instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/foodyz_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/foodyz_dev

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Full base URL of the app
AUTH_URL=http://localhost:3000

# Vercel Blob — create a store at vercel.com/storage/blob, copy the read-write token
BLOB_READ_WRITE_TOKEN=

# Seed / E2E admin credentials
ADMIN_EMAIL=admin@foodyz.app
ADMIN_PASSWORD=
