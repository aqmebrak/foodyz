# Used by Playwright (playwright.config.ts) and `pnpm db:test:*`. Disposable DB from docker-compose.yml (db-test, :5434).
# Non-secret on purpose: these only work against the throwaway local DB.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/foodyz_test
DIRECT_URL=postgresql://postgres:postgres@localhost:5434/foodyz_test
AUTH_SECRET=e2e-test-secret-not-for-production
AUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@foodyz.test
ADMIN_PASSWORD=e2e-password
